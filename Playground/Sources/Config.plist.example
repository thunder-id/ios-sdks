    <!-- <key>THUNDERID_ENDPOINT_ROLES</key><string>https://localhost:9090/roles</string> -->
    <!-- <key>THUNDERID_ENDPOINT_AGENTS</key><string>https://localhost:9090/agents</string> -->
    <!-- <key>THUNDERID_ENDPOINT_AGENT_TYPES</key><string>https://localhost:9090/agent-types</string> -->
</dict>
</plist>
